OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Host-side development. Compose overrides these with internal service addresses.
DATABASE_URL=postgresql+psycopg://agents:agents@localhost:5432/agents
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_URL=http://localhost:8233
TEMPORAL_TASK_QUEUE=agents-platform
LOG_LEVEL=INFO
# Local operator API access only. Production firm/case authentication is separate.
OPERATOR_API_KEY=local-development-only
# scripted = deterministic SDK model for the demo; openai requires OPENAI_API_KEY.
AGENT_MODE=scripted
DEMO_FOLLOW_UP_SECONDS=30
DEMO_MAX_ACTIVATIONS=6

# Per-call model input estimate, output cap and per-activation context tool calls
CONTEXT_INPUT_TOKENS=12000
CONTEXT_OUTPUT_TOKENS=1500
CONTEXT_RETRIEVAL_CALLS=4

# Operations thresholds; alerts appear in the dashboard and JSON logs.
OPS_POLL_SECONDS=15
OPS_OUTBOX_AGE_SECONDS=60
OPS_WORKER_DELAY_SECONDS=120
OPS_CALLBACK_GRACE_SECONDS=60
OPS_REVIEW_AGE_SECONDS=86400

# Local observability: run .venv/bin/python scripts/setup_observability.py first.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENVIRONMENT=local
SERVICE_VERSION=0.1.0
JAEGER_UI_URL=http://localhost:16686
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_UI_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=hellocounsel-agents
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Host setup: scripts/setup_audit.py generates these and switches DATABASE_URL.
# Keep migration credentials out of the API/worker environment.
# MIGRATION_DATABASE_URL=postgresql+psycopg://agents:agents@localhost:5432/agents
# DATABASE_APP_USER=agents_app
# DATABASE_APP_PASSWORD=<generated-by-setup>

LANGFUSE_CONTENT_MODE=redacted

# Local fictional demo: state routine assumptions instead of interrupting.
DEMO_ASSUME_ROUTINE_UPDATES=false
